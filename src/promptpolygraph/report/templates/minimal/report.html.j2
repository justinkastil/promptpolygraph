<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ branding.title }}</title>
<style>
:root { --accent: {{ branding.accent }}; --border: #d9d9de; --panel: #f6f6f8; --pass: #1b7f37; --fail: #b01b1b; }
* { box-sizing: border-box; }
body { margin: 0; padding: 2rem 1.25rem 4rem; max-width: 760px; margin: 0 auto;
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #1c1c1e; }
h1 { font-size: 1.6rem; color: var(--accent); margin: 0 0 .5rem; }
h2 { font-size: 1.2rem; border-bottom: 2px solid var(--accent); padding-bottom: .25rem; margin-top: 2rem; }
.verdict { font-weight: 700; padding: .6rem .9rem; border-radius: 8px; background: var(--panel); border-left: 4px solid var(--accent); margin: 1rem 0; }
.verdict.pass { color: var(--pass); } .verdict.fail { color: var(--fail); }
table { border-collapse: collapse; width: 100%; font-size: .9rem; margin-top: .5rem; }
th, td { border: 1px solid var(--border); padding: .35rem .5rem; text-align: left; }
th { background: var(--panel); }
.muted { color: #6b6b70; }
</style></head>
<body>
{%- macro fmt(v) -%}{% if v is none %}&mdash;{% else %}{{ v }}{% endif %}{%- endmacro -%}
<h1>{{ branding.title }}</h1>
<p class="muted">Run <code>{{ cover.run_id }}</code>{% if cover.model %} &middot; {{ cover.model }}{% endif %}{% if cover.adapter %} &middot; {{ cover.adapter }}{% endif %}</p>
<div class="verdict {{ 'pass' if cover.overall_pass else 'fail' }}">
  {{ cover.verdict }} &mdash; {{ cover.categories_passing }}/{{ cover.categories_total }} categories passing
</div>
{% if charts and charts.dimension_bars %}
<div style="margin:.75rem 0">{{ charts.dimension_bars | safe }}</div>
{% endif %}

<h2>Category scores</h2>
<table><thead><tr><th>Category</th><th>Count</th>{% for d in dimensions %}<th>{{ d }}</th>{% endfor %}<th>Pass</th>{% if has_baseline %}<th>&Delta;</th>{% endif %}</tr></thead><tbody>
{% for cat in categories %}<tr><td>{{ cat.name }}</td><td>{{ cat.count }}</td>{% for ds in cat.dim_scores %}<td>{{ fmt(ds.value) }}</td>{% endfor %}<td>{{ 'PASS' if cat.pass else 'FAIL' }}</td>{% if has_baseline %}<td>{% for d in cat.deltas %}{{ d.dimension }} {{ d.delta }}{% if not loop.last %}, {% endif %}{% else %}&mdash;{% endfor %}</td>{% endif %}</tr>
{% endfor %}</tbody></table>
</body></html>
